-- ========================================================
-- 3. FLING
-- ========================================================
local function flingCharacter(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then return end

	hrp.AssemblyLinearVelocity = Vector3.new(
		math.random(-50, 50), math.random(150, 250), math.random(-50, 50)
	)
	hrp.AssemblyAngularVelocity = Vector3.new(
		math.random(-30, 30), math.random(-30, 30), math.random(-30, 30)
	)
	humanoid.PlatformStand = true
	task.delay(2, function()
		if humanoid and humanoid.Health > 0 then
			humanoid.PlatformStand = false
		end
	end)
end

local function findPlayerByName(name)
	name = string.lower(name)
	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == name or string.lower(player.DisplayName) == name then
			return player
		end
	end
	return nil
end

-- ========================================================
-- 4. INICIALIZAR
-- ========================================================
local remoteEvent = createRemoteEvent()
createGUI()

remoteEvent.OnServerEvent:Connect(function(player, targetName)
	if not targetName or targetName == "" then return end
	local targetPlayer = findPlayerByName(targetName)
	if not targetPlayer then return end
	local character = targetPlayer.Character
	if character then
		flingCharacter(character)
	end
end)

print("Death Note cargado correctamente.")
